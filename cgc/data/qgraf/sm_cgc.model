%
% QGRAF model file: Standard Model + CGC composite operators
% Generated by cgc.engine.qgraf_backend (2026-07-30)
%
% QGRAF spin convention:
%   0 = scalar    (spin-0)
%   1 = spinor    (spin-1/2)
%   2 = vector    (spin-1)
%   3 = spin-3/2  (Rarita–Schwinger)
%   4 = spin-2    (tensor)
%
% Color representation:
%   0 = colourless
%   1 = singlet (leptons)
%   3 = triplet (quarks, fundamental)
%   8 = octet (gluons, adjoint)
%
% QGRAF syntax:
%   [fields]   <name> <latex> <spin> <mass> <width> <color>
%   [prpgtrs]  <from> <to> [<type>]
%   [vertices] <fields separated by commas>
%
% Reference:
%   P. Nogueira, "Automatic Feynman graph generation",
%   J. Comput. Phys. 105 (1993) 279–289.

% ────────────────────────────────────────────────────────────
% Output options
% ────────────────────────────────────────────────────────────
[options
  style = "cgc_qgraf.sty"
  loop  = 2
  ;

% ────────────────────────────────────────────────────────────
% Fields
% ────────────────────────────────────────────────────────────
[fields
  % ── External slow-momentum legs (spin-0, massless, singlet) ──
  p1        p_1            0  0  0  0
  p2        p_2            0  0  0  0

  % ── CGC Composite Operator (insertion vertex) ──
  % Spin/Mass/Width/Color are operator-dependent placeholders;
  % the backend substitutes correct values per operator type.
  CGC_op    \(\mathcal{O}\)  4  0  0  0

  % ── SM Quark Fields (spin-1/2 = 1, massless UV, colour 3) ──
  qL        q_L            1  0  0  3   % quark doublet (L)
  uR        u_R            1  0  0  3   % up-type singlet (R)
  dR        d_R            1  0  0  3   % down-type singlet (R)

  % ── SM Lepton Fields (spin-1/2 = 1, massless UV, colour 1) ──
  lL        l_L            1  0  0  1   % lepton doublet (L)
  eR        e_R            1  0  0  1   % charged lepton singlet (R)
  nuR       \(\nu_R\)      1  0  0  1   % sterile neutrino (R, seesaw-compatible)

  % ── SM Gauge Bosons (spin-1 = 2, massless UV) ──
  B         B_\mu          2  0  0  1   % U(1)_Y
  W         W_\mu          2  0  0  2   % SU(2)_L (colour index = adjoint dimension)
  G         G_\mu          2  0  0  8   % SU(3)_c (colour octet)

  % ── SM Higgs Doublet (spin-0, mass M_H, colour 2 = weak isospin) ──
  H         H              0  0  0  2   % Higgs doublet (mass inserted via substitution)

  % ── Faddeev–Popov Ghosts (spin-0, massless) ──
  cB        c_B            0  0  0  1   % U(1)_Y ghost
  cW        c_W            0  0  0  2   % SU(2)_L ghost
  cG        c_G            0  0  0  8   % SU(3)_c ghost
  cGbar     \bar{c}_G      0  0  0  8   % anti-ghost (QCD, for vertex listing)
  cWbar     \bar{c}_W      0  0  0  2   % anti-ghost (SU(2))
  cBbar     \bar{c}_B      0  0  0  1   % anti-ghost (U(1))
  ;

% ────────────────────────────────────────────────────────────
% Propagators
% ────────────────────────────────────────────────────────────
[prpgtrs
  % External legs (self-propagating, never internal)
  p1       p1
  p2       p2
  CGC_op   CGC_op

  % SM fermion propagators
  qL       qL
  uR       uR
  dR       dR
  lL       lL
  eR       eR
  nuR      nuR

  % SM gauge boson propagators
  B        B
  W        W
  G        G

  % Higgs propagator
  H        H

  % Ghost propagators
  cB       cBbar
  cW       cWbar
  cG       cGbar
  ;

% ────────────────────────────────────────────────────────────
% Vertices
% ────────────────────────────────────────────────────────────
[vertices
  % ════════════════════════════════════════════════════════
  % CGC Composite Operator Insertions
  %   Operator(p1, p2) couples to each SM field through a
  %   3-point insertion vertex: CGC_op + p1 + field + p2 + field
  %   (QGRAF vertex format: space-separated field names)
  % ════════════════════════════════════════════════════════

  % === Tμν (CONSERVED_CURRENT, universal coupling) ===
  CGC_op, p1, qL,  p2, qL
  CGC_op, p1, uR,  p2, uR
  CGC_op, p1, dR,  p2, dR
  CGC_op, p1, lL,  p2, lL
  CGC_op, p1, eR,  p2, eR
  CGC_op, p1, nuR, p2, nuR
  CGC_op, p1, B,   p2, B
  CGC_op, p1, W,   p2, W
  CGC_op, p1, G,   p2, G
  CGC_op, p1, H,   p2, H

  % ════════════════════════════════════════════════════════
  % SM Interaction Vertices
  % ════════════════════════════════════════════════════════

  % ── QCD (SU(3)_c) ──
  qL, qL, G              % quark–quark–gluon
  uR, uR, G              % u_R–u_R–gluon
  dR, dR, G              % d_R–d_R–gluon
  G,  G,  G              % triple-gluon
  G,  G,  G, G           % quartic-gluon
  cG, cGbar, G           % ghost–anti-ghost–gluon

  % ── Electroweak ──
  % Quark–gauge
  qL, qL, B              % quark doublet + U(1)_Y
  qL, qL, W              % quark doublet + SU(2)_L (charged + neutral)
  uR, uR, B              % u_R + U(1)_Y
  dR, dR, B              % d_R + U(1)_Y

  % Lepton–gauge
  lL, lL, B              % lepton doublet + U(1)_Y
  lL, lL, W              % lepton doublet + SU(2)_L
  eR, eR, B              % e_R + U(1)_Y
  nuR, nuR, B            % ν_R + U(1)_Y (if B-L charged)

  % Gauge self-interactions
  W,  W,  W              % triple-W
  W,  W,  W, W           % quartic-W

  % Ghost–gauge
  cW, cWbar, W           % SU(2) ghost–anti-ghost–W
  cW, cWbar, B           % SU(2) ghost–anti-ghost–B
  cB, cBbar, B           % U(1) ghost (Abelian, typically decoupled)

  % ── Yukawa ──
  qL, uR, H              % up-type Yukawa
  qL, dR, H              % down-type Yukawa
  lL, eR, H              % charged lepton Yukawa
  lL, nuR, H             % Dirac neutrino Yukawa

  % ── Higgs Sector ──
  H,  H,  H              % cubic Higgs
  H,  H,  H, H           % quartic Higgs
  H,  H,  B, B           % Higgs–B–B (from covariant derivative)
  H,  H,  W, W           % Higgs–W–W
  H,  H,  G, G           % Higgs–gluon–gluon (1-loop effective, for completeness)
  ;

% End of model file
